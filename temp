~/.pixi/bin/pixi run python3 << 'EOF'\nimport polars as pl\nimport altair as alt\nfrom funbuns.querydb import QueryDB\n\nwith QueryDB(read_only=True) as db:\n    df = db.conn.execute('''\n        SELECT d.p, d.m_k AS m\n        FROM partition_counts pc\n        JOIN decompositions d ON pc.p = d.p\n        WHERE pc.k = 1\n    ''').pl()\n\ndf = df.with_columns(pl.col('p').cast(pl.Float64).log(base=2).alias('log2_p'))\n\nchart = alt.Chart(df).mark_circle(size=1, opacity=0.3).encode(\n    x=alt.X('m:Q', title='m'),\n    y=alt.Y('log2_p:Q', title='log₂(p)'),\n).properties(\n    title='k=1 primes: log₂(p) vs m',\n    width=800,\n    height=500,\n)\n\nchart.save('/home/erpage159/fluid/research/funbuns/k1_log2p_vs_m.html')\nprint(f'{df.shape[0]:,} points plotted → k1_log2p_vs_m.html')\nEOF\n
